{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dashboard: serve",
      "type": "process",
      "command": "bun",
      "args": ["run", "dev"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": {
        "owner": "dashboard",
        "pattern": {"regexp": "^(.*):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4},
        "background": {"activeOnStart": true, "beginsPattern": "^.*$", "endsPattern": "^Davao Ordinance Observatory:"}
      }
    },
    {
      "label": "Dashboard: validate exports and server",
      "type": "process",
      "command": "bun",
      "args": ["run", "test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: fresh coarse-grained retraining",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/run_four_configurations.py", "--config", "configs/coarse_grained_retrain.json"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: publish fresh coarse-grained evidence",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/publish_coarse_grained.py", "--titles", "configs/temporal_topic_titles_coarse_grained.json"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: prepare full clean-TXT corpus",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/prepare_clean_text.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: run both models on full clean-TXT corpus",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/run_clean_text.py", "--config", "configs/clean_text_full.json"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: resume interrupted full experiment",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/run_clean_text.py", "--config", "configs/clean_text_full.json", "--resume"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: render new clean-TXT presentation",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/build_clean_presentation.py", "--output", "artifacts/clean_text_rerender"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Historical: rerender Conservative temporal graphs",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/build_temporal_graphs.py", "--output", "artifacts/temporal_topics_rerender"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: clean-text pipeline tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/test_clean_text.py", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
