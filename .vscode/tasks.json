{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Thesis: prepare full clean-TXT corpus",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/prepare_clean_text.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: run both models on full clean-TXT corpus",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/run_clean_text.py", "--config", "configs/clean_text_full.json"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: resume interrupted full experiment",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/run_clean_text.py", "--config", "configs/clean_text_full.json", "--resume"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: render new clean-TXT presentation",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/build_clean_presentation.py", "--output", "artifacts/clean_text_rerender"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: temporal-only graphs with topic titles",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/build_temporal_graphs.py", "--output", "artifacts/temporal_topics_rerender"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Thesis: clean-text pipeline tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/test_clean_text.py", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
