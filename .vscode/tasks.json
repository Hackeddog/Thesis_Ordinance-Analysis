{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Thesis: run exploratory two-model pilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/run_comparison.py", "--config", "configs/pilot.json"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Thesis: build presentation from completed pilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/build_presentation.py", "--experiment", "results/experiments/pilot", "--output", "artifacts/pilot-rerender"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Thesis: model correctness tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/test_models.py", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
